#!/usr/bin/env bash
# voodu — universal installer.
#
# Usage:
#   curl -fsSL https://raw.githubusercontent.com/thadeu/clowk-voodu/main/install | bash
#   curl -fsSL ...install | bash -s -- --client
#   curl -fsSL ...install | bash -s -- --server
#
# Server mode (default on Linux): installs base deps + Docker, drops the
# `voodu` and `voodu-controller` binaries, seeds /opt/voodu, enables the
# voodu-controller.service systemd unit, adds the deploy user to the
# docker group, AND installs the default plugins (voodu-caddy for
# ingress) so a fresh box can serve `app` blocks immediately. Truly
# turnkey — a fresh Ubuntu/Debian/RHEL/Alpine box ends ready to deploy.
#
# Client mode (default on macOS, forced on Linux with --client): just
# the CLI — meant for laptops that deploy to remote servers.
#
# Env knobs:
#   VERSION                 pin a release (default: latest from GitHub)
#   VOODU_INSTALL_REPO      source repo (default: thadeu/clowk-voodu)
#   VOODU_ROOT              server state dir (default: /opt/voodu)
#   VOODU_HTTP_ADDR         orchestration plane bind, loopback-only by
#                           default (default: 127.0.0.1:8686). CLI reaches
#                           this via SSH tunnel.
#   VOODU_PAT_ADDR          PAT-authenticated observability plane bind
#                           (default: 0.0.0.0:8687). Reachable from the
#                           Rails WebUI — FIREWALL TO YOUR WEBUI HOST IP.
#                           Empty disables the plane entirely.
#   VOODU_DEFAULT_PLUGINS   space-separated plugins to install on first
#                           boot (default: thadeu/voodu-caddy)
#   SKIP_DOCKER=1           skip Docker install (server mode only)
#   SKIP_PLUGINS=1          skip default plugin install (offline boxes)

set -euo pipefail

REPO="${VOODU_INSTALL_REPO:-thadeu/clowk-voodu}"
VERSION="${VERSION:-}"
VOODU_ROOT="${VOODU_ROOT:-/opt/voodu}"
VOODU_HTTP_ADDR="${VOODU_HTTP_ADDR:-127.0.0.1:8686}"
VOODU_PAT_ADDR="${VOODU_PAT_ADDR:-0.0.0.0:8687}"
SKIP_DOCKER="${SKIP_DOCKER:-0}"
SKIP_WIREGUARD="${SKIP_WIREGUARD:-0}"
UFW_HINT_BRIDGE=""
VOODU_WG_ADDRESS="${VOODU_WG_ADDRESS:-}"
BIN_DIR="/usr/local/bin"
UNIT_PATH="/etc/systemd/system/voodu-controller.service"
MODE=""
OS=""
ARCH=""
DISTRO=""
TARGET_USER=""

RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[1;33m'
CYAN=$'\033[0;36m'
NC=$'\033[0m'

log()     { printf '%s[voodu/install]%s %s\n' "$CYAN" "$NC" "$*"; }
success() { printf '%s[voodu/install]%s %s\n' "$GREEN" "$NC" "$*"; }
warn()    { printf '%s[voodu/install]%s %s\n' "$YELLOW" "$NC" "$*"; }
fail()    { printf '%s[voodu/install]%s %s\n' "$RED" "$NC" "$*" >&2; exit 1; }

sudo_() {
  if [ "$(id -u)" -eq 0 ]; then
    "$@"
  else
    sudo "$@"
  fi
}

parse_args() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --server) MODE=server; shift ;;
      --client) MODE=client; shift ;;
      --wg-address) VOODU_WG_ADDRESS="${2:-}"; shift 2 ;;
      --wg-address=*) VOODU_WG_ADDRESS="${1#*=}"; shift ;;
      --help|-h)
        cat <<EOF
voodu installer

Usage: install [--server | --client] [--wg-address 10.254.X.Y]

Default mode:
  Linux  → server  (auto-installs Docker + voodu + controller + systemd unit)
  macOS  → client  (CLI only)

Environment:
  VERSION               pin a release, e.g. v0.1.0 (default: latest)
  VOODU_INSTALL_REPO    default thadeu/clowk-voodu
  VOODU_ROOT            default /opt/voodu
  VOODU_HTTP_ADDR       orchestration plane bind (default 127.0.0.1:8686)
  VOODU_PAT_ADDR        observability plane bind (default 0.0.0.0:8687)
  SKIP_DOCKER=1         skip Docker install (server mode only)
  SKIP_WIREGUARD=1      skip WireGuard (server mode only; voodu0 stays local)
  VOODU_WG_ADDRESS      this host's tunnel address when wg0 is created
                        (default 10.254.<last two numbers of the outbound IP>)
EOF
        exit 0
        ;;
      *) fail "unknown option: $1 (try --help)" ;;
    esac
  done
}

detect_platform() {
  case "$(uname -s)" in
    Linux)  OS=linux ;;
    Darwin) OS=darwin ;;
    *) fail "unsupported OS: $(uname -s)" ;;
  esac

  case "$(uname -m)" in
    x86_64|amd64)  ARCH=amd64 ;;
    arm64|aarch64) ARCH=arm64 ;;
    *) fail "unsupported arch: $(uname -m)" ;;
  esac

  if [ -z "$MODE" ]; then
    case "$OS" in
      linux)  MODE=server ;;
      darwin) MODE=client ;;
    esac
  fi

  if [ "$MODE" = "server" ] && [ "$OS" != "linux" ]; then
    fail "server mode requires Linux (detected $OS). Re-run with --client."
  fi

  if [ "$OS" = "linux" ] && [ -r /etc/os-release ]; then
    DISTRO="$(. /etc/os-release && echo "${ID:-unknown}")"
  else
    DISTRO="$OS"
  fi

  # The user that will own /opt/voodu and receive tarball pushes over
  # SSH. When the script runs as a regular user with sudo, that user is
  # the deploy user. When run as root (cloud-init), fall back to
  # SUDO_USER if present, else root.
  if [ "$(id -u)" -eq 0 ]; then
    TARGET_USER="${SUDO_USER:-root}"
  else
    TARGET_USER="$USER"
  fi

  log "platform: $OS/$ARCH ($DISTRO)   mode: $MODE   deploy user: $TARGET_USER"
}

ensure_base_packages() {
  local missing=()

  command -v curl >/dev/null || missing+=("curl")
  command -v tar  >/dev/null || missing+=("tar")
  command -v git  >/dev/null || missing+=("git")

  if [ "$MODE" = "server" ]; then
    command -v systemctl >/dev/null 2>&1 || [ "$DISTRO" = "alpine" ] || missing+=("systemd")
  fi

  if [ ${#missing[@]} -eq 0 ]; then
    return
  fi

  log "installing base packages: ${missing[*]}"

  case "$DISTRO" in
    ubuntu|debian)
      sudo_ apt-get update -qq
      sudo_ apt-get install -y --no-install-recommends "${missing[@]}"
      ;;
    centos|rhel|fedora|rocky|almalinux|amzn)
      sudo_ yum install -y "${missing[@]}"
      ;;
    alpine)
      sudo_ apk add --no-cache "${missing[@]}"
      ;;
    darwin)
      fail "missing on macOS: ${missing[*]} — install with brew or Xcode CLT and re-run."
      ;;
    *)
      fail "missing packages on unsupported distro ($DISTRO): ${missing[*]}.
  Install them with your package manager and re-run."
      ;;
  esac
}

ensure_docker() {
  if [ "$SKIP_DOCKER" = "1" ]; then
    warn "SKIP_DOCKER=1 — skipping Docker install (you must install it before deploying)"
    return
  fi

  if command -v docker >/dev/null; then
    log "docker already installed: $(docker --version)"
  else
    log "installing Docker..."
    case "$DISTRO" in
      ubuntu|debian) install_docker_debian ;;
      centos|rhel|fedora|rocky|almalinux|amzn) install_docker_rhel ;;
      alpine) install_docker_alpine ;;
      *) fail "automatic Docker install not supported for $DISTRO.
  Install Docker manually (https://docs.docker.com/engine/install/) and re-run, or pass SKIP_DOCKER=1 to skip." ;;
    esac
  fi

  ensure_docker_running
  add_user_to_docker_group
  wait_for_docker_ready
  ensure_voodu_network
}

# ensure_wireguard installs WireGuard and gives this host its place on the
# voodu tunnel. Required in server mode, like Docker: voodu0 is routed over
# wg0, so wg0 has to exist before the network is created.
ensure_wireguard() {
  if [ "$SKIP_WIREGUARD" = "1" ]; then
    warn "SKIP_WIREGUARD=1 — skipping WireGuard; voodu0 will stay local to this host"
    return
  fi

  if command -v wg >/dev/null && command -v wg-quick >/dev/null; then
    log "wireguard already installed: $(wg --version 2>/dev/null | head -n1)"
  else
    install_wireguard_tools
  fi

  ensure_wg0
}

install_wireguard_tools() {
  log "installing WireGuard..."

  case "$DISTRO" in
    ubuntu|debian)
      sudo_ apt-get update -qq
      sudo_ apt-get install -y --no-install-recommends wireguard
      ;;
    centos|rhel|fedora|rocky|almalinux|amzn)
      sudo_ yum install -y wireguard-tools
      ;;
    alpine)
      sudo_ apk add --no-cache wireguard-tools
      ;;
    *)
      fail "automatic WireGuard install not supported for $DISTRO.
  Install wireguard-tools manually and re-run, or pass SKIP_WIREGUARD=1 to skip."
      ;;
  esac
}

# ensure_wg0 gives this host a wg0 when it has none — no peers yet, just
# its address and keys, so another host can be pointed at it. An existing
# wg0 (the interface, or /etc/wireguard/wg0.conf) is never touched: it is
# the operator's, and rewriting it would cut the tunnel.
ensure_wg0() {
  if ip link show wg0 >/dev/null 2>&1 || sudo_ test -e /etc/wireguard/wg0.conf; then
    log "wg0 already configured — leaving it as is"
    fix_wg0_postup
    return
  fi

  local address

  if ! address="$(voodu_wg_address)"; then
    warn "wg0 not created — voodu0 will stay local to this host" >&2
    return
  fi

  log "creating wg0 at $address/16"

  sudo_ install -m 0700 -d /etc/wireguard
  sudo_ sh -c 'umask 077 && wg genkey > /etc/wireguard/privatekey'
  sudo_ sh -c 'wg pubkey < /etc/wireguard/privatekey > /etc/wireguard/publickey'

  # The second PostUp brings back the peers `vd wire add` keeps under
  # VOODU_ROOT, so a rebooted host is wired before the controller starts.
  # addconf, not syncconf: syncconf rewrites the interface too, and with
  # no [Interface] in that file it would reset the listen port.
  printf '[Interface]\nAddress = %s/16\nListenPort = 51820\nPostUp = wg set %%i private-key /etc/wireguard/privatekey\nPostUp = test -f %s/wire/peers.conf && wg addconf %%i %s/wire/peers.conf || true\n' "$address" "$VOODU_ROOT" "$VOODU_ROOT" \
    | sudo_ sh -c 'umask 077 && cat > /etc/wireguard/wg0.conf'

  if command -v systemctl >/dev/null 2>&1; then
    sudo_ systemctl enable --now wg-quick@wg0 >/dev/null
  else
    sudo_ wg-quick up wg0 >/dev/null
    warn "no systemd — wg0 is up now, but will not come back after a reboot on its own"
  fi

  success "wg0 is $address — public key $(sudo_ cat /etc/wireguard/publickey)"
  log "open UDP 51820, then wire it to the other hosts with 'vd wire'"
}

# fix_wg0_postup rewrites the one line in wg0.conf that an earlier voodu
# install wrote wrong: `wg syncconf` on the peers file resets the listen
# port to a random one, so the peers never handshake. Only that exact line
# is touched — the rest of the file is the operator's. The running
# interface gets its port back too, without dropping the tunnel.
fix_wg0_postup() {
  local conf=/etc/wireguard/wg0.conf
  local bad="wg syncconf %i $VOODU_ROOT/wire/peers.conf"

  if ! sudo_ grep -qF "$bad" "$conf" 2>/dev/null; then
    return
  fi

  warn "wg0.conf reapplies peers with 'wg syncconf', which resets the listen port — switching to 'wg addconf'"
  sudo_ sed -i "s|$bad|wg addconf %i $VOODU_ROOT/wire/peers.conf|" "$conf"

  local port
  port="$(sudo_ awk -F' *= *' '$1 == "ListenPort" { print $2 }' "$conf" | head -n1)"

  if [ -n "$port" ] && ip link show wg0 >/dev/null 2>&1; then
    sudo_ wg set wg0 listen-port "$port" private-key /etc/wireguard/privatekey 2>/dev/null \
      && log "wg0 listening on $port again"
  fi
}

# voodu_wg_address prints this host's address on the voodu tunnel: the
# --wg-address override, or 10.254.<last two numbers of the IP this host
# goes out on> (152.53.91.221 → 10.254.91.221). The whole IP is unique per
# host; its last two numbers leave 65k combinations, so two hosts landing
# on the same one is negligible — and --wg-address settles it when they do.
#
# The outbound IP comes from the routing table rather than a named
# interface, so eth0, eth1, ens3 all work. Returns non-zero — saying why on
# stderr — when no usable address comes out.
voodu_wg_address() {
  local addr src a b c d

  addr="$VOODU_WG_ADDRESS"

  if [ -z "$addr" ]; then
    src="$(ip -4 route get 1.1.1.1 2>/dev/null \
      | awk '{ for (i = 1; i < NF; i++) if ($i == "src") { print $(i + 1); exit } }' || true)"

    if [ -z "$src" ]; then
      warn "cannot tell which IP this host goes out on — pass --wg-address 10.254.X.Y" >&2
      return 1
    fi

    IFS=. read -r a b c d <<<"$src"
    addr="10.254.$c.$d"
  fi

  IFS=. read -r a b c d <<<"$addr"

  if [ "$a.$b" != "10.254" ] || ! is_octet "$c" || ! is_octet "$d" \
    || [ "$c.$d" = "0.0" ] || [ "$c.$d" = "255.255" ]; then
    warn "$addr is not a host address on the voodu tunnel (10.254.0.0/16)" >&2
    return 1
  fi

  # 10.254.254.Y would put this host's containers in 10.254.Y.0/24 — inside
  # the tunnel itself. The outbound IP's third number happening to be 254
  # is the one case the derivation cannot handle; the operator picks any
  # other third number.
  if [ "$c" = "254" ]; then
    warn "$addr would place this host's containers inside the tunnel (10.254.$d.0/24) — pass --wg-address 10.254.X.$d with another X" >&2
    return 1
  fi

  printf '%s\n' "$addr"
}

is_octet() {
  case "$1" in
    ''|*[!0-9]*) return 1 ;;
  esac

  [ "$1" -le 255 ]
}

# ensure_voodu_network creates the shared docker bridge that voodu-caddy
# and every managed app join. Caddy needs the same network as upstreams
# so it can resolve container names via docker's embedded DNS — without
# this, ingress would fail with "dial tcp: lookup <app>: no such host".
#
# On a host with WireGuard, voodu0 is created routed: its subnet comes from
# the wg0 address, and every container on it is reachable from the other
# voodu hosts on the tunnel at its own address, on any port. Without wg0
# (or when a check fails) it is a plain bridge, local to this host.
#
# An existing voodu0 is never touched — changing its subnet means
# recreating it and every container on it, which is a migration the
# operator runs on purpose, not something an install does in passing.
ensure_voodu_network() {
  if sudo_ docker network inspect voodu0 >/dev/null 2>&1; then
    log "docker network voodu0 already exists"

    # Created before this host had a wg0 (an earlier install, or one with
    # SKIP_WIREGUARD=1): it is local, and only a migration makes it routed.
    if [ -z "$(sudo_ docker network inspect voodu0 -f '{{range .IPAM.Config}}{{.IPRange}}{{end}}' 2>/dev/null)" ] \
      && ip -4 -o addr show dev wg0 2>/dev/null | grep -q ' inet 10\.254\.'; then
      warn "voodu0 has no routed subnet, but wg0 is on the voodu tunnel — see Cross-VM networking to migrate"
    fi

    return
  fi

  local subnet

  if subnet="$(routed_voodu0_subnet)"; then
    log "creating docker network voodu0, routed over wg0 ($subnet)"
    # --gateway is explicit: without it docker takes the first address of
    # --ip-range, which puts the gateway at .128 instead of .1.
    sudo_ docker network create --driver bridge \
      --subnet "$subnet" \
      --gateway "${subnet%.0/24}.1" \
      --ip-range "${subnet%.0/24}.128/25" \
      -o com.docker.network.bridge.gateway_mode_ipv4=nat-unprotected \
      voodu0 >/dev/null
    success "voodu0 is $subnet — wire this host to the others with 'vd wire'"
    return
  fi

  log "creating docker network voodu0"
  sudo_ docker network create --driver bridge voodu0 >/dev/null
}

# voodu0_bridge prints voodu0's host interface when the network is routed
# over wg0 (it has an --ip-range), nothing otherwise.
voodu0_bridge() {
  local id

  if [ -z "$(sudo_ docker network inspect voodu0 -f '{{range .IPAM.Config}}{{.IPRange}}{{end}}' 2>/dev/null)" ]; then
    return 1
  fi

  id="$(sudo_ docker network inspect voodu0 -f '{{.Id}}' 2>/dev/null | cut -c1-12)"
  [ -n "$id" ] || return 1

  printf 'br-%s\n' "$id"
}

# ufw_rules prints the rules cross-VM needs, one per line, as ufw
# arguments — the same list `vd wire ufw` computes.
ufw_rules() {
  local bridge="$1"

  printf '%s\n' \
    "allow 51820/udp" \
    "allow in on wg0 to any port 53" \
    "allow in on $bridge to any port 53" \
    "route allow in on wg0 out on $bridge"
}

# ensure_firewall opens what the mesh needs — only when ufw is active,
# which is the one case where the tunnel would otherwise be silently
# blocked. ufw skips a rule it already has, so re-running adds nothing.
# With ufw absent or inactive the rules are printed at the end instead;
# a different firewall is the operator's.
ensure_firewall() {
  local bridge rule

  bridge="$(voodu0_bridge)" || return 0

  if ! command -v ufw >/dev/null 2>&1 || ! sudo_ ufw status 2>/dev/null | grep -q '^Status: active'; then
    UFW_HINT_BRIDGE="$bridge"
    return 0
  fi

  log "ufw is active — allowing the WireGuard mesh through"

  ufw_rules "$bridge" | while IFS= read -r rule; do
    # shellcheck disable=SC2086
    sudo_ ufw $rule >/dev/null
  done

  success "ufw: 51820/udp, DNS on wg0 and $bridge, forwarding wg0 → $bridge"
}

# routed_voodu0_subnet derives voodu0's subnet from this host's address on
# the voodu tunnel: 10.254.X.Y → 10.X.Y.0/24. Tunnel addresses are unique
# across hosts, so the subnets are too, with nothing to coordinate.
#
# The lower half of the subnet is left to the controller, which pins
# statefulset pods there; docker hands out the upper half (--ip-range).
#
# Prints the subnet, or returns non-zero — saying why on stderr — when
# voodu0 should stay a plain bridge. stdout carries only the subnet: the
# caller captures it.
routed_voodu0_subnet() {
  local addr a b c d subnet version major inside covering

  addr="$(ip -4 -o addr show dev wg0 2>/dev/null | awk '{print $4}' | head -n1 || true)"

  if [ -z "$addr" ]; then
    log "no IPv4 address on wg0 — voodu0 stays local to this host" >&2
    return 1
  fi

  IFS=. read -r a b c d <<<"${addr%/*}"

  # A wg0 outside the voodu tunnel — set up by hand before voodu managed
  # it — has no place in the plan: its address cannot name a subnet.
  if [ "$a.$b" != "10.254" ]; then
    warn "wg0 is ${addr%/*}, outside the voodu tunnel 10.254.0.0/16 — voodu0 stays local to this host (see Cross-VM networking to migrate)" >&2
    return 1
  fi

  subnet="10.$c.$d.0/24"

  # Routed access to unpublished ports is gateway mode nat-unprotected,
  # which docker added in 28.
  version="$(sudo_ docker version --format '{{.Server.Version}}' 2>/dev/null || true)"
  major="${version%%.*}"

  case "$major" in
    ''|*[!0-9]*) major=0 ;;
  esac

  if [ "$major" -lt 28 ]; then
    warn "docker ${version:-unknown} is older than 28 — voodu0 stays local to this host" >&2
    return 1
  fi

  # A route inside the subnet, or one covering it (the tunnel's own
  # network, a peer's subnet from AllowedIPs), means the address is taken.
  # Output is captured whole rather than piped into `grep -q`: an early
  # exit there can SIGPIPE `ip`, and under pipefail that reads as "no
  # overlap" — exactly the wrong answer.
  inside="$(ip -4 route show root "$subnet" 2>/dev/null || true)"
  covering="$(ip -4 route show match "10.$c.$d.0" 2>/dev/null | grep -v '^default' || true)"

  if [ -n "$inside" ] || [ -n "$covering" ]; then
    warn "$subnet overlaps a route on this host — voodu0 stays local to this host" >&2
    return 1
  fi

  printf '%s\n' "$subnet"
}

install_docker_debian() {
  sudo_ apt-get update -qq
  sudo_ apt-get install -y --no-install-recommends \
    apt-transport-https ca-certificates gnupg lsb-release

  local distro_id
  distro_id="$(. /etc/os-release && echo "$ID")"

  sudo_ install -m 0755 -d /etc/apt/keyrings

  curl -fsSL "https://download.docker.com/linux/${distro_id}/gpg" \
    | sudo_ gpg --batch --yes --dearmor -o /etc/apt/keyrings/docker.gpg
  sudo_ chmod a+r /etc/apt/keyrings/docker.gpg

  local arch_dpkg
  arch_dpkg="$(dpkg --print-architecture)"

  local codename
  codename="$(. /etc/os-release && echo "${VERSION_CODENAME:-$(lsb_release -cs)}")"

  echo "deb [arch=${arch_dpkg} signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/${distro_id} ${codename} stable" \
    | sudo_ tee /etc/apt/sources.list.d/docker.list >/dev/null

  sudo_ apt-get update -qq
  sudo_ apt-get install -y --no-install-recommends \
    docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
}

install_docker_rhel() {
  sudo_ yum install -y yum-utils
  sudo_ yum-config-manager --add-repo https://download.docker.com/linux/centos/docker-ce.repo
  sudo_ yum install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
}

install_docker_alpine() {
  sudo_ apk add --no-cache docker docker-cli docker-compose docker-cli-buildx
}

ensure_docker_running() {
  if [ "$DISTRO" = "alpine" ]; then
    sudo_ rc-update add docker default >/dev/null 2>&1 || true
    sudo_ service docker start >/dev/null 2>&1 || true
  else
    sudo_ systemctl enable docker >/dev/null 2>&1 || true
    sudo_ systemctl start docker
  fi
}

wait_for_docker_ready() {
  local i=0
  while [ $i -lt 15 ]; do
    if sudo_ docker ps >/dev/null 2>&1; then
      success "docker is ready: $(docker --version)"
      return
    fi
    i=$((i + 1))
    sleep 1
  done
  warn "docker daemon did not become ready in 15s — check 'systemctl status docker'"
}

add_user_to_docker_group() {
  if [ "$TARGET_USER" = "root" ]; then
    return
  fi

  if id -nG "$TARGET_USER" 2>/dev/null | tr ' ' '\n' | grep -qx docker; then
    log "$TARGET_USER already in docker group"
    return
  fi

  log "adding $TARGET_USER to docker group"
  sudo_ groupadd -f docker
  sudo_ usermod -aG docker "$TARGET_USER"

  warn "$TARGET_USER must log out and back in (or run 'newgrp docker') for group membership to take effect"
}

resolve_version() {
  if [ -n "$VERSION" ]; then
    log "version: $VERSION (pinned)"
    return
  fi

  log "resolving latest release from GitHub API..."

  local api="https://api.github.com/repos/${REPO}/releases/latest"

  VERSION="$(curl -fsSL "$api" | sed -n 's/.*"tag_name":[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"

  if [ -z "$VERSION" ]; then
    fail "could not resolve latest release from $api. Set VERSION=vX.Y.Z to pin."
  fi

  log "version: $VERSION (latest)"
}

download_and_install_binary() {
  local binary="$1"

  local num_version="${VERSION#v}"
  local archive="${binary}_${num_version}_${OS}_${ARCH}.tar.gz"
  local url="https://github.com/${REPO}/releases/download/${VERSION}/${archive}"

  log "downloading $archive"

  local tmp
  tmp="$(mktemp -d)"

  if ! curl -fsSL "$url" -o "$tmp/$archive"; then
    rm -rf "$tmp"
    fail "download failed: $url"
  fi

  (cd "$tmp" && tar -xzf "$archive")

  if [ ! -x "$tmp/$binary" ]; then
    rm -rf "$tmp"
    fail "archive $archive did not contain an executable named $binary"
  fi

  sudo_ install -m 0755 "$tmp/$binary" "$BIN_DIR/$binary"
  rm -rf "$tmp"

  # `vd` shorthand for the voodu CLI — every command in the docs and
  # help text uses it, and operators expect both names to work. Only
  # symlinked for the user-facing `voodu` binary; the controller
  # daemon doesn't need an alias.
  if [ "$binary" = "voodu" ]; then
    sudo_ ln -sf "$BIN_DIR/voodu" "$BIN_DIR/vd"
    success "installed $BIN_DIR/$binary (alias: $BIN_DIR/vd)"
  else
    success "installed $BIN_DIR/$binary"
  fi
}

server_setup() {
  log "creating $VOODU_ROOT owned by $TARGET_USER"
  sudo_ install -m 0755 -d "$VOODU_ROOT"

  # Subdirs the controller and per-app paths expect to exist. The CLI
  # used to do this via `voodu setup`, but the bootstrap responsibility
  # moved entirely to this installer — keeping the dir creation here
  # means the CLI binary stays purely operational (no install commands).
  for sub in apps services plugins scripts state volumes; do
    sudo_ install -m 0755 -d "$VOODU_ROOT/$sub"
  done

  if [ "$TARGET_USER" != "root" ]; then
    sudo_ chown -R "$TARGET_USER":"$TARGET_USER" "$VOODU_ROOT"
  fi

  write_voodurc_server_mode
  write_systemd_unit
  enable_controller
  install_default_plugins
  install_uninstaller
}

# install_uninstaller stamps the matching `uninstall` script under
# $VOODU_ROOT/scripts/ so operators can wipe the host without
# having to remember the GitHub raw URL. Pinned to the same VERSION
# as the install so the cleanup logic always matches the layout
# this installer just laid down (paths, labels, systemd unit name).
#
# Silent on both success and failure — operators see the stamped
# path in print_next_steps below, and the curl-based fallback is
# documented there too. Failure modes (network blip, tag without
# uninstall yet) are recoverable post-install via a manual curl.
#
# Idempotent: re-running the installer overwrites with the
# matching version.
install_uninstaller() {
  local dst="$VOODU_ROOT/scripts/uninstall"

  # Use the same git ref the binaries came from. `main` falls back
  # only when VERSION wasn't resolved for some reason.
  local ref="${VERSION:-main}"
  local url="https://raw.githubusercontent.com/${REPO}/${ref}/uninstall"

  local tmp
  tmp="$(mktemp)"

  if ! curl -fsSL "$url" -o "$tmp" 2>/dev/null; then
    rm -f "$tmp"
    return
  fi

  if ! sudo_ install -m 0755 "$tmp" "$dst" 2>/dev/null; then
    rm -f "$tmp"
    return
  fi

  rm -f "$tmp"

  if [ "$TARGET_USER" != "root" ]; then
    sudo_ chown "$TARGET_USER":"$TARGET_USER" "$dst" 2>/dev/null || true
  fi
}

# write_voodurc_server_mode marks $TARGET_USER's ~/.voodurc with
# `mode=server`. The CLI's IsServerMode() reads this to decide
# whether `voodu apply` runs locally (server mode) or SSH-forwards to
# a remote (client mode, default). Without this, every `voodu`
# invocation on the server would try to forward to itself.
#
# Idempotent: rewrites an existing `mode=` line in place; appends if
# absent; preserves any other lines (operators sometimes drop config
# unrelated to mode in the same file).
write_voodurc_server_mode() {
  local home
  if [ "$TARGET_USER" = "root" ]; then
    home="/root"
  else
    home="$(getent passwd "$TARGET_USER" | cut -d: -f6)"
    [ -n "$home" ] || home="/home/$TARGET_USER"
  fi

  local rc="$home/.voodurc"

  log "marking $rc as mode=server"

  if [ -f "$rc" ] && grep -q '^mode=' "$rc" 2>/dev/null; then
    sudo_ sed -i 's/^mode=.*/mode=server/' "$rc"
  else
    echo "mode=server" | sudo_ tee -a "$rc" >/dev/null
  fi

  if [ "$TARGET_USER" != "root" ]; then
    sudo_ chown "$TARGET_USER":"$TARGET_USER" "$rc"
  fi
}

write_systemd_unit() {
  log "writing $UNIT_PATH"

  local tmp
  tmp="$(mktemp)"

  cat >"$tmp" <<UNIT
[Unit]
Description=Voodu Controller — embedded etcd + reconciler + observability API
Documentation=https://github.com/${REPO}
# wg-quick@wg0 is ordered, not required: a host installed with
# SKIP_WIREGUARD has no such unit, and After= on a missing unit is harmless.
After=network-online.target docker.service wg-quick@wg0.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
Environment=VOODU_ROOT=${VOODU_ROOT}
Environment=VOODU_HTTP_ADDR=${VOODU_HTTP_ADDR}
Environment=VOODU_PAT_ADDR=${VOODU_PAT_ADDR}
ExecStart=${BIN_DIR}/voodu-controller
Restart=on-failure
RestartSec=5s
LimitNOFILE=1048576

# Sandboxing — least-privilege boundaries the controller doesn't
# need to cross. Defence-in-depth against a compromised binary or
# plugin: the controller talks to dockerd via its socket and writes
# its own state under \${VOODU_ROOT}; nothing else on the filesystem
# is its concern.
#
# ProtectSystem=strict       → entire FS read-only (with the
#                              well-known exceptions /tmp, /var/tmp,
#                              /proc, /sys, /dev — see systemd.exec(5))
# ReadWritePaths=\${VOODU_ROOT} → carve back write access to the state
#                              dir only (etcd data, metrics NDJSON,
#                              caddy logs bind-mount target)
# ProtectHome=yes            → /home, /root invisible to the controller
# NoNewPrivileges=yes        → can't gain privileges via setuid/setcap;
#                              child docker CLI invocations honour this
ProtectSystem=strict
ReadWritePaths=${VOODU_ROOT}
ProtectHome=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
UNIT

  sudo_ install -m 0644 "$tmp" "$UNIT_PATH"
  rm -f "$tmp"

  sudo_ systemctl daemon-reload
}

enable_controller() {
  sudo_ systemctl enable voodu-controller.service >/dev/null
  sudo_ systemctl restart voodu-controller.service
  sleep 1

  if sudo_ systemctl is-active --quiet voodu-controller.service; then
    success "voodu-controller running (orchestration ${VOODU_HTTP_ADDR}, observability ${VOODU_PAT_ADDR})"
  else
    warn "voodu-controller failed to start — inspect: sudo journalctl -u voodu-controller -n 50"
  fi
}

# wait_for_controller_http blocks until the controller's /health
# endpoint responds 2xx, capped at 30s. systemctl is-active returns
# true the moment the process spawns, but the HTTP listener takes
# another beat to bind — without this gate, install_default_plugins
# below would fire `voodu plugins install` against a port that
# isn't ready and the plugin would silently fail to land.
wait_for_controller_http() {
  local i=0

  while [ $i -lt 30 ]; do
    if curl -fsS -m 2 "http://${VOODU_HTTP_ADDR}/health" >/dev/null 2>&1; then
      return 0
    fi

    i=$((i + 1))
    sleep 1
  done

  warn "controller HTTP did not respond within 30s — skipping default plugin install"
  return 1
}

# install_default_plugins materialises the out-of-the-box plugin
# set so a fresh server can serve `app` blocks (deployment +
# ingress) without a follow-up install step. Default is just
# voodu-caddy — the reference ingress impl, required by every
# `ingress { ... }` HCL block.
#
# Env knobs:
#   SKIP_PLUGINS=1            skip entirely (offline installs)
#   VOODU_DEFAULT_PLUGINS=... space-separated source list overriding
#                             the default. Sources are anything
#                             `voodu plugins install` accepts (github
#                             shorthand, full URL, local path).
#
# Best-effort: a failed plugin install warns but doesn't abort the
# bootstrap — the operator can `voodu plugins install` manually
# later. The most common failure (no internet on the VM) shouldn't
# leave them with a half-broken install.
install_default_plugins() {
  if [ "${SKIP_PLUGINS:-0}" = "1" ]; then
    log "SKIP_PLUGINS=1 — skipping default plugin install"
    return
  fi

  if ! wait_for_controller_http; then
    return
  fi

  local plugins="${VOODU_DEFAULT_PLUGINS:-thadeu/voodu-caddy}"

  for p in $plugins; do
    log "installing plugin: $p"

    if "$BIN_DIR/voodu" plugins install "$p" >/dev/null 2>&1; then
      success "installed plugin: $p"
    else
      warn "failed to install plugin $p — finish manually with: voodu plugins install $p"
    fi
  done
}

print_next_steps() {
  echo
  if [ "$MODE" = "server" ]; then
    cat <<EOF
  State:        $VOODU_ROOT (owned by $TARGET_USER)
  Orchestration:  http://${VOODU_HTTP_ADDR}   (loopback — CLI reaches via SSH)
  Observability:  http://${VOODU_PAT_ADDR}   (PAT-authenticated; firewall to WebUI host IP)
  Systemd unit:   voodu-controller.service
  Binaries:     $BIN_DIR/voodu, $BIN_DIR/voodu-controller (alias: $BIN_DIR/vd)
  Docker:       $(docker --version 2>/dev/null || echo "not installed")

  Mint a PAT for the WebUI:
    voodu pat create --name=webui --scope=read,actions

  ${YELLOW}Heads up${NC}: the observability plane on :8687 is reachable from the
  network by default. Restrict it to your WebUI host before exposing
  any data:
    sudo ufw allow from WEBUI_HOST_IP to any port 8687 proto tcp
    sudo ufw deny  8687/tcp
${UFW_HINT_BRIDGE:+
  ${YELLOW}Cross-VM${NC}: ufw is not active here, so nothing was opened. If a
  firewall fronts this host, it needs the tunnel and the mesh DNS through
  (\`vd wire ufw\` prints these at any time):
$(ufw_rules "$UFW_HINT_BRIDGE" | sed 's/^/    sudo ufw /')
}

  To uninstall (local — stamped at install time):
    sudo $VOODU_ROOT/scripts/uninstall
    sudo $VOODU_ROOT/scripts/uninstall --prune       # wipe state + docker resources

  Or pull the latest cleanup logic from GitHub:
    curl -fsSL https://raw.githubusercontent.com/${REPO}/main/uninstall | bash
    curl -fsSL https://raw.githubusercontent.com/${REPO}/main/uninstall | bash -s -- --prune

EOF
  else
    cat <<EOF
  Binary:  $BIN_DIR/voodu (alias: $BIN_DIR/vd)

  To uninstall:
    curl -fsSL https://raw.githubusercontent.com/${REPO}/main/uninstall | bash

EOF
  fi
}

main() {
  parse_args "$@"
  detect_platform
  ensure_base_packages

  if [ "$MODE" = "server" ]; then
    # WireGuard first: voodu0 is routed over wg0, and ensure_docker creates
    # voodu0 at its end.
    ensure_wireguard
    ensure_docker
    ensure_firewall
  fi

  resolve_version
  download_and_install_binary voodu

  if [ "$MODE" = "server" ]; then
    download_and_install_binary voodu-controller
    server_setup
  fi

  print_next_steps
  success "installation complete"
}

main "$@"
